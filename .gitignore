# 密钥文件——绝对不能上传！
.env

# docs 目录整体不上传：所有原始 PDF 一律留在本机。
# 云端只用下面放行的"公开版 txt"重建知识库，仓库里永远没有公司文件原件。
docs/*
!docs/public/
!docs/public/*.txt

# 整个向量库目录都不上传（云端首次访问时 app.py 会用公开版 txt 自动重建）
db/

# 防刷计数库：里面有访问者 IP 和提问次数，属于运行数据，不上传
.guard/

# 本地 Secrets（如果为了测试建过，绝不能上传）
.streamlit/secrets.toml

# Python 运行产物
__pycache__/
*.pyc
.venv/
